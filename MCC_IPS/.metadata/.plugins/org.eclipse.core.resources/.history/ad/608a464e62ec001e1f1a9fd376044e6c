#include "pwmCommand.h"
#include "tim.h"
#include "gpio.h"


static int PWM_Toggle;

//duty cycle de commande (2 degrees de precisions) vers valeur pulse
uint32_t pulseCalc(float val)
{
	uint32_t pulseVal = 0;
	pulseVal = (uint32_t)(val*(65535)/100);
	return pulseVal;
}

void pwmInit(void){

	HAL_TIM_PWM_Start(&htim3, TIM_CHANNEL_1);
	//__HAL_TIM_SetCompare(&htim3, TIM_CHANNEL_1, 50);
	TIM2->CCR1 = 32768;
}

void pwmSetDuty(float duty) //
{
	//Formula duty : Pulse Value = duty*(2^16 - 1)/100
	//Float = 32bits

	__HAL_TIM_SetCompare(&htim3, TIM_CHANNEL_1, pulseCalc(duty));
}

void pwmEnable(void)
{
	HAL_TIM_PWM_Start(&htim3, TIM_CHANNEL_1);
}

void pwmDisable(void)
{
	HAL_TIM_PWM_Stop(&htim3, TIM_CHANNEL_1);
}

void pwmToggle(void)
{
	/*PWM_Toggle :
	* 0 = Off
	* 1 = On
	*/
	if (PWM_Toggle == 0)
	{
		pwmEnable();
		PWM_Toggle = 1;
	}
	else
	{
		pwmDisable();
		PWM_Toggle = 0;
	}
}
